// Personal Clinical Record – Prisma schema (Phase 8: documents + export/backup support)
// Fields follow docs/DATA_MODEL.md + Gate / research lock in docs/app-plan.md.
// Do not invent product fields beyond those sources.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

/// Minimal bootstrap / operational metadata (not clinical).
model AppMeta {
  id        String   @id @default(cuid())
  key       String   @unique
  value     String
  createdAt DateTime @default(now()) @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @db.Timestamptz(3)

  @@map("app_meta")
}

/// Local admin account (MVP: single User). actorId for AuditEvent.
model User {
  id           String    @id @default(uuid()) @db.Uuid
  username     String    @unique
  passwordHash String
  displayName  String?
  role         UserRole  @default(ADMIN)
  createdAt    DateTime  @default(now()) @db.Timestamptz(3)
  updatedAt    DateTime  @updatedAt @db.Timestamptz(3)

  sessions    Session[]
  auditEvents AuditEvent[]

  @@map("users")
}

enum UserRole {
  ADMIN
}

model Session {
  id               String   @id @default(uuid()) @db.Uuid
  userId           String   @db.Uuid
  tokenHash        String   @unique
  csrfToken        String
  expiresAt        DateTime @db.Timestamptz(3)
  createdAt        DateTime @default(now()) @db.Timestamptz(3)
  lastSeenAt       DateTime @default(now()) @db.Timestamptz(3)
  rotatedFromId    String?  @db.Uuid
  userAgentSummary String?
  ipHash           String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
  @@map("sessions")
}

enum PhoneUse {
  mobile
  home
  work
  other
}

enum AddressForm {
  formal_surname
  formal_title
  given_name
  preferred_name
  neutral
  custom
  en_mr_ms
  en_first
}

enum AddressGender {
  male
  female
  neutral
}

enum SexAtBirth {
  female
  male
  intersex
  unknown
  prefer_not_to_say
}

model Patient {
  id          String  @id @default(uuid()) @db.Uuid
  displayName String
  givenName   String?
  familyName  String?
  birthDate   DateTime? @db.Date
  sexAtBirth  SexAtBirth?
  heightCm    Decimal?  @db.Decimal(5, 2)
  bloodGroup  String?
  timezone    String    @default("Europe/Prague")

  // Research lock – contact
  phone         String?
  phoneUse      PhoneUse?
  email         String?
  addressLine   String?
  addressCity   String?
  addressPostalCode String?
  addressCountry    String? @default("CZ")
  emergencyContactName         String?
  emergencyContactRelationship String?
  emergencyContactPhone        String?
  emergencyContactEmail        String?
  contactNote String?

  // Research lock – addressing
  preferredName       String?
  addressForm         AddressForm @default(preferred_name)
  titlePrefix         String?
  titleSuffix         String?
  salutationOverride  String?
  addressGender       AddressGender?

  // Research lock – default weight (not Observation history)
  defaultWeightKg Decimal? @db.Decimal(6, 2)

  // Research lock – explicit NKA flag (≠ unknown allergy record)
  noKnownAllergies Boolean @default(false)

  isActive  Boolean  @default(true)
  createdAt DateTime @default(now()) @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @db.Timestamptz(3)

  diagnoses               Diagnosis[]
  allergies               Allergy[]
  observationDefinitions  ObservationDefinition[]
  observations            Observation[]
  medicationOrders          MedicationOrder[]
  medicationAdministrations MedicationAdministration[]
  clinicalNotes             ClinicalNote[]
  symptomEntries            SymptomEntry[]
  diaryScaleDefinitions     DiaryScaleDefinition[]
  diaryScaleSettings        DiaryScaleSetting[]
  diaryScaleReadings        DiaryScaleReading[]
  documents                 Document[]
  auditEvents               AuditEvent[]

  @@index([isActive])
  @@map("patients")
}

enum DiagnosisStatus {
  active
  in_remission
  resolved
  unconfirmed
  historical
}

model Diagnosis {
  id          String          @id @default(uuid()) @db.Uuid
  patientId   String          @db.Uuid
  display     String
  codeSystem  String?
  code        String?
  status      DiagnosisStatus @default(active)
  onsetDate   DateTime?       @db.Date
  resolvedDate DateTime?      @db.Date
  source      String?
  notes       String?
  createdAt   DateTime        @default(now()) @db.Timestamptz(3)
  updatedAt   DateTime        @updatedAt @db.Timestamptz(3)

  patient Patient @relation(fields: [patientId], references: [id], onDelete: Restrict)

  @@index([patientId, status])
  @@map("diagnoses")
}

enum AllergySeverity {
  mild
  moderate
  severe
  unknown
}

enum AllergyStatus {
  active
  inactive
  unconfirmed
}

enum AllergyVerification {
  confirmed_by_clinician
  patient_reported
  unknown
}

model Allergy {
  id           String              @id @default(uuid()) @db.Uuid
  patientId    String              @db.Uuid
  substance    String
  reaction     String?
  severity     AllergySeverity     @default(unknown)
  status       AllergyStatus       @default(active)
  verification AllergyVerification @default(patient_reported)
  onsetDate    DateTime?           @db.Date
  notes        String?
  createdAt    DateTime            @default(now()) @db.Timestamptz(3)
  updatedAt    DateTime            @updatedAt @db.Timestamptz(3)

  patient Patient @relation(fields: [patientId], references: [id], onDelete: Restrict)

  @@index([patientId, status])
  @@map("allergies")
}

enum ObservationCategory {
  vital_sign
  laboratory
  body_measurement
  symptom_score
  custom
}

enum ObservationValueType {
  quantity
  integer
  decimal
  boolean
  text
  ratio
}

enum ObservationSource {
  manual
  device_import
  document_import
}

/// Catalog of measurable quantities. System rows have patientId null.
model ObservationDefinition {
  id               String                 @id @default(uuid()) @db.Uuid
  patientId        String?                @db.Uuid
  key              String
  label            String
  category         ObservationCategory
  valueType        ObservationValueType
  canonicalUnit    String?
  allowedUnits     Json?
  displayPrecision Int                    @default(0)
  lowerReference   Decimal?               @db.Decimal(12, 4)
  upperReference   Decimal?               @db.Decimal(12, 4)
  /// When true, numericValue + secondaryNumericValue form a pair (e.g. BP).
  supportsPair     Boolean                @default(false)
  isSystem         Boolean                @default(false)
  isActive         Boolean                @default(true)
  createdAt        DateTime               @default(now()) @db.Timestamptz(3)
  updatedAt        DateTime               @updatedAt @db.Timestamptz(3)

  patient      Patient?       @relation(fields: [patientId], references: [id], onDelete: Cascade)
  observations Observation[]

  @@index([patientId, isActive])
  @@index([key])
  @@map("observation_definitions")
}

model Observation {
  id                    String            @id @default(uuid()) @db.Uuid
  patientId             String            @db.Uuid
  definitionId          String            @db.Uuid
  numericValue          Decimal?          @db.Decimal(14, 4)
  secondaryNumericValue Decimal?          @db.Decimal(14, 4)
  textValue             String?
  unit                  String
  occurredAt            DateTime          @db.Timestamptz(3)
  recordedAt            DateTime          @default(now()) @db.Timestamptz(3)
  method                String?
  bodySite              String?
  context               String?
  source                ObservationSource @default(manual)
  notes                 String?
  createdAt             DateTime          @default(now()) @db.Timestamptz(3)
  updatedAt             DateTime          @updatedAt @db.Timestamptz(3)

  patient    Patient               @relation(fields: [patientId], references: [id], onDelete: Restrict)
  definition ObservationDefinition @relation(fields: [definitionId], references: [id], onDelete: Restrict)

  @@index([patientId, occurredAt])
  @@index([patientId, definitionId, occurredAt])
  @@map("observations")
}

enum MedicationRegimen {
  scheduled
  prn
  once
  course
  other
}

enum MedicationOrderStatus {
  draft
  active
  paused
  completed
  discontinued
  cancelled
}

enum MedicationSourceType {
  clinician_order
  patient_recorded_plan
  historical
  other
}

enum MedicationRoute {
  oral
  sublingual
  topical
  inhalation
  injection
  infusion
  ophthalmic
  otic
  rectal
  other
}

/// Planned / recorded medication order — not proof of administration.
model MedicationOrder {
  id               String                @id @default(uuid()) @db.Uuid
  patientId        String                @db.Uuid
  medicationName   String
  activeIngredient String?
  strengthValue    Decimal?              @db.Decimal(14, 4)
  strengthUnit     String?
  form             String?
  doseValue        Decimal               @db.Decimal(14, 4)
  doseUnit         String
  route            MedicationRoute
  regimen          MedicationRegimen     @default(scheduled)
  frequencyText    String?
  scheduledTimes   Json?
  instructions     String?
  indication       String?
  startAt          DateTime              @db.Timestamptz(3)
  endAt            DateTime?             @db.Timestamptz(3)
  status           MedicationOrderStatus @default(active)
  sourceType       MedicationSourceType  @default(patient_recorded_plan)
  sourceLabel      String?
  createdAt        DateTime              @default(now()) @db.Timestamptz(3)
  updatedAt        DateTime              @updatedAt @db.Timestamptz(3)

  patient          Patient                     @relation(fields: [patientId], references: [id], onDelete: Restrict)
  administrations  MedicationAdministration[]

  @@index([patientId, status])
  @@index([patientId, startAt])
  @@map("medication_orders")
}

enum MedicationAdministrationStatus {
  taken
  partially_taken
  refused
  omitted
  delayed
  unknown
}

/// Actual administration / intake event. Snapshot fields freeze order details.
model MedicationAdministration {
  id                     String                          @id @default(uuid()) @db.Uuid
  patientId              String                          @db.Uuid
  medicationOrderId      String?                         @db.Uuid
  medicationNameSnapshot String
  doseValue              Decimal                         @db.Decimal(14, 4)
  doseUnit               String
  routeSnapshot          MedicationRoute
  status                 MedicationAdministrationStatus
  occurredAt             DateTime                        @db.Timestamptz(3)
  recordedAt             DateTime                        @default(now()) @db.Timestamptz(3)
  reason                 String?
  notes                  String?
  idempotencyKey         String                          @unique
  createdAt              DateTime                        @default(now()) @db.Timestamptz(3)
  updatedAt              DateTime                        @updatedAt @db.Timestamptz(3)

  patient Patient          @relation(fields: [patientId], references: [id], onDelete: Restrict)
  order   MedicationOrder? @relation(fields: [medicationOrderId], references: [id], onDelete: SetNull)

  @@index([patientId, occurredAt])
  @@index([medicationOrderId, occurredAt])
  @@map("medication_administrations")
}

/// Gate / research lock — overrides DATA_MODEL subjective|objective|… enum.
enum ClinicalNoteType {
  DIARY
  VISIT_SUMMARY
  MEDICATION_NOTE
  RESULT_NOTE
  CARE_NOTE
  OTHER
}

enum ClinicalNoteSource {
  manual
  import
  other
}

/// Personal clinical-style note (not an official clinical record).
model ClinicalNote {
  id         String             @id @default(uuid()) @db.Uuid
  patientId  String             @db.Uuid
  noteType   ClinicalNoteType
  title      String?
  body       String
  occurredAt DateTime           @db.Timestamptz(3)
  recordedAt DateTime           @default(now()) @db.Timestamptz(3)
  source     ClinicalNoteSource @default(manual)
  createdAt  DateTime           @default(now()) @db.Timestamptz(3)
  updatedAt  DateTime           @updatedAt @db.Timestamptz(3)

  patient Patient @relation(fields: [patientId], references: [id], onDelete: Restrict)

  @@index([patientId, occurredAt])
  @@index([patientId, noteType])
  @@map("clinical_notes")
}

/// Individual symptom event (quick-add + full form).
model SymptomEntry {
  id             String    @id @default(uuid()) @db.Uuid
  patientId      String    @db.Uuid
  symptom        String
  intensity      Decimal?  @db.Decimal(5, 2)
  /// e.g. "0-10"
  intensityScale String?
  location       String?
  character      String?
  onsetAt        DateTime? @db.Timestamptz(3)
  endedAt        DateTime? @db.Timestamptz(3)
  occurredAt     DateTime  @db.Timestamptz(3)
  recordedAt     DateTime  @default(now()) @db.Timestamptz(3)
  context        String?
  notes          String?
  createdAt      DateTime  @default(now()) @db.Timestamptz(3)
  updatedAt      DateTime  @updatedAt @db.Timestamptz(3)

  patient Patient @relation(fields: [patientId], references: [id], onDelete: Restrict)

  @@index([patientId, occurredAt])
  @@map("symptom_entries")
}

/// Configurable diary scales (mood, anxiety, energy…). System rows: patientId null.
model DiaryScaleDefinition {
  id        String   @id @default(uuid()) @db.Uuid
  patientId String?  @db.Uuid
  key       String
  label     String
  minValue  Int      @default(0)
  maxValue  Int      @default(10)
  sortOrder Int      @default(0)
  isSystem  Boolean  @default(false)
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now()) @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @db.Timestamptz(3)

  patient  Patient?            @relation(fields: [patientId], references: [id], onDelete: Cascade)
  settings DiaryScaleSetting[]

  @@index([patientId, isActive])
  @@index([key])
  @@map("diary_scale_definitions")
}

/// Per-patient enable/disable (and optional range override) for a scale.
model DiaryScaleSetting {
  id           String  @id @default(uuid()) @db.Uuid
  patientId    String  @db.Uuid
  definitionId String  @db.Uuid
  isEnabled    Boolean @default(true)
  minValue     Int?
  maxValue     Int?
  createdAt    DateTime @default(now()) @db.Timestamptz(3)
  updatedAt    DateTime @updatedAt @db.Timestamptz(3)

  patient    Patient              @relation(fields: [patientId], references: [id], onDelete: Cascade)
  definition DiaryScaleDefinition @relation(fields: [definitionId], references: [id], onDelete: Cascade)

  @@unique([patientId, definitionId])
  @@index([patientId])
  @@map("diary_scale_settings")
}

/// One diary check-in with multiple scale scores (keyed by definition key).
model DiaryScaleReading {
  id         String   @id @default(uuid()) @db.Uuid
  patientId  String   @db.Uuid
  /// JSON object: { "mood": 7, "anxiety": 3, … } — only enabled scales.
  values     Json
  occurredAt DateTime @db.Timestamptz(3)
  recordedAt DateTime @default(now()) @db.Timestamptz(3)
  notes      String?
  createdAt  DateTime @default(now()) @db.Timestamptz(3)
  updatedAt  DateTime @updatedAt @db.Timestamptz(3)

  patient Patient @relation(fields: [patientId], references: [id], onDelete: Restrict)

  @@index([patientId, occurredAt])
  @@map("diary_scale_readings")
}

/// Attachment for backup/export path (DATA_MODEL Document). No MVP nav agenda.
model Document {
  id               String    @id @default(uuid()) @db.Uuid
  patientId        String    @db.Uuid
  originalFileName String
  storageKey       String    @unique
  mimeType         String
  sizeBytes        Int
  documentType     String
  documentDate     DateTime? @db.Date
  uploadedAt       DateTime  @default(now()) @db.Timestamptz(3)
  sourceLabel      String?
  notes            String?
  checksum         String
  createdAt        DateTime  @default(now()) @db.Timestamptz(3)
  updatedAt        DateTime  @updatedAt @db.Timestamptz(3)

  patient Patient @relation(fields: [patientId], references: [id], onDelete: Restrict)

  @@index([patientId, uploadedAt])
  @@map("documents")
}

enum AuditAction {
  create
  update
  correction
  archive
  restore
  export
  backup
  login
  logout
  setup
}

model AuditEvent {
  id            String      @id @default(uuid()) @db.Uuid
  patientId     String?     @db.Uuid
  actorId       String?     @db.Uuid
  entityType    String
  entityId      String
  action        AuditAction
  occurredAt    DateTime    @default(now()) @db.Timestamptz(3)
  reason        String?
  changeSummary String?
  beforeJson    Json?
  afterJson     Json?
  requestId     String?

  patient Patient? @relation(fields: [patientId], references: [id], onDelete: SetNull)
  actor   User?    @relation(fields: [actorId], references: [id], onDelete: SetNull)

  @@index([patientId, occurredAt])
  @@index([entityType, entityId])
  @@index([actorId, occurredAt])
  @@map("audit_events")
}
