# =============================================================================
# Personal Clinical Record – environment template
# =============================================================================
# Copy to combat-server (or local) as `.env` or `.env.local` and fill secrets.
#   cp .env.example .env
# Never commit real passwords or session secrets. Public repo.
#
# Stack: Next.js + Prisma + PostgreSQL
# Public app: https://health.combatostrich.dev (HTTPS)
# First-run: setup wizard in UI + env bootstrap from this file
# Session cookies: HttpOnly, SameSite=Lax, Secure when served over HTTPS
# =============================================================================

# --- Runtime ---
NODE_ENV=production

# Canonical public URL of the app (no trailing slash)
# Production: https://health.combatostrich.dev
APP_URL=https://health.combatostrich.dev

# Optional: expose the same URL to the client if needed by Next.js
# NEXT_PUBLIC_APP_URL=https://health.combatostrich.dev

# --- PostgreSQL (Prisma) ---
# Production DB name and role (confirmed): database=health, user=health
# Password: set only on the server — never commit the real value.
#
# Host: use localhost if Postgres is on the same host as the app,
#       or the Docker/Compose service name if on a docker network.
# Port: usually 5432
#
# Prisma primary connection string (URL-encode special chars in the password):
DATABASE_URL=postgresql://health:CHANGE_ME_DB_PASSWORD@localhost:5432/health?schema=public

# Discrete libpq-style vars (optional; useful for ops / non-Prisma tooling).
# Keep in sync with DATABASE_URL when both are used.
PGHOST=localhost
# PGHOST=postgres          # example: Docker Compose service name on a shared network
PGPORT=5432
PGUSER=health
PGPASSWORD=CHANGE_ME_DB_PASSWORD
PGDATABASE=health

# --- Session / auth secrets ---
# Generate a long random string (e.g. openssl rand -base64 32). Required in production.
SESSION_SECRET=CHANGE_ME_SESSION_SECRET

# Cookie policy (confirmed): SameSite=Lax
# Also use Secure on HTTPS and HttpOnly for the session cookie (app code / ARCHITECTURE).
# SESSION_COOKIE_SAMESITE=Lax

# Optional override for Secure cookie flag (normally derived from X-Forwarded-Proto / APP_URL / localhost).
# FORCE_SECURE_COOKIES=true
# FORCE_SECURE_COOKIES=false

# --- Private storage (documents + backups; never under public/) ---
# Default: ./storage relative to WorkingDirectory
# STORAGE_ROOT=/var/webserver/health.combatostrich.dev/storage
